# Environment variables for Job Search Command Center

# Notion Sync Configuration (Optional)
# If ENABLE_NOTION_SYNC is true, these are required.
NOTION_API_KEY=
NOTION_JOBS_DATABASE_ID=
ENABLE_NOTION_SYNC=false

# AI Summary Backend
# SUMMARY_PROVIDER: auto (default) | anthropic | ollama
#   auto  — use ANTHROPIC_API_KEY if set, else fall back to a local Ollama server
ANTHROPIC_API_KEY=
SUMMARY_PROVIDER=auto
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=qwen3.5:latest
OLLAMA_NUM_CTX=32768
